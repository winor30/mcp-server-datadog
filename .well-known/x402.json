      "price": "0.01",
      "description": "Pay-per-call access to get_logs"
    },
    {
      "path": "/list_dashboards",
      "price": "0.01",
      "description": "Pay-per-call access to list_dashboards"
    },
    {
      "path": "/get_dashboard",
      "price": "0.01",
      "description": "Pay-per-call access to get_dashboard"
    },
    {
      "path": "/query_metrics",
      "price": "0.01",
      "description": "Pay-per-call access to query_metrics"
    },
    {
      "path": "/list_traces",
      "price": "0.01",
      "description": "Pay-per-call access to list_traces"
    },
    {
      "path": "/list_hosts",
      "price": "0.01",
      "description": "Pay-per-call access to list_hosts"
