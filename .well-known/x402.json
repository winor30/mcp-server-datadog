{
  "name": "winor30/mcp-server-datadog",
  "description": "MCP server for interacting with Datadog API",
  "accepts": [
    {
      "network": "eip155:8453",
      "asset": "USDC",
      "address": "YOUR_WALLET_ADDRESS"
    }
  ],
  "resources": [
    {
      "path": "/list_incidents",
